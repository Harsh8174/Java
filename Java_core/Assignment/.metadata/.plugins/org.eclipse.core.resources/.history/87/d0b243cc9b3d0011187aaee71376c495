package Programs;

import java.io.FileReader;
import java.io.FileWriter;
import java.io.IOException;

public class P36_FileReaderWriter {
      
	void writer () throws IOException  
	{
		FileWriter fwr=new FileWriter("user1.txt");
        String str="Hello this is hello world program";
        fwr.write(str);
        fwr.flush();
        fwr.close();
	}
	void reader () throws IOException {
		FileReader fir=new FileReader("user1.txt");
		//int i;
		while((fir.read()!=-1)) {
			System.out.print((char)fir.read());
		}
		fir.close();
		
	}
	public static void main(String[] args) {
		 P36_FileReaderWriter obj=new P36_FileReaderWriter();
		 try {
		 obj.writer();
		 obj.reader();
		 }
		 catch (IOException e) {
			System.out.println("Exception Hnadled");
		}
	} 
}
