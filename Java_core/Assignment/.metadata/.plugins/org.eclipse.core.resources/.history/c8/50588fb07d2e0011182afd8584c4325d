package Programs;
import java.util.Scanner;
public class FibonacciSeries {
public static void main(String[] args) {
	Scanner sc=new Scanner(System.in);
	var num = sc.nextInt();
    int result =0;
    int i=1;
	while(i<=num) {
		System.out.print(" "+result);   
		result = result + i;
		System.out.print(" "+i);
		i= i+result;
	}
}
}
