package Programs;
import java.util.Scanner;
public class FibonacciSeries {
public static void main(String[] args) {
	Scanner sc=new Scanner(System.in);
	var num = sc.nextInt();
	int j=0;
	for(int i=1;i<=num;i++) {
		while(j<i) {
			System.out.print(" "+j);
			j=i+j;
			System.out.print(" "+i+" "+j);
		}
	}
}
}
