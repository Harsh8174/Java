package Programs;

class A {
	A(){System.out.println("A class constructor called");}
	A(int i){
		System.out.println("A class constructor called");
	}
	 void Bmethod() {
		System.out.println("A class method called");
	}
	
}
class B extends A{
	B(){
		System.out.println("B class constructor called");
	}
	void Bmethod() {
		System.out.println("B class method called");
	}
}
class C extends B {
	C(){
		System.out.println("C class constructor called");
	}
	void Cmethod() {
		System.out.println("C class method called");
	}
}

public class Inheritance {
      public static void main(String[] args) {
    	  A obj=new B();
