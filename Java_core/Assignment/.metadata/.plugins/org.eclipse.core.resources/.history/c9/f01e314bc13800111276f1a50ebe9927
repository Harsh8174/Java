package Programs;

public class TwoDMatrices {
public static void main(String[] args) {
	int one[]= {1,2,3};
	int second []= {4,5,6};
	int arr []= new int[one.length];
	for(int i=0;i<one.length;i++) {
		
		arr[i]=one[i];
		System.out.println(arr[i]);
		for(int j=0;j<second.length;j++) {
			arr[j]=second[j];
			
			System.out.print(arr[j]);
		}
	}
}
}
